{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open UI",
  "version": "0.1.0-1",
  "identifier": "in.qezvo.openui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open UI",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:11434 http://localhost:11434 https://github.com https://api.github.com; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Open-source visual UI builder",
    "longDescription": "A local-first Windows desktop visual UI builder with optional local and online AI assistance."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NzQyNDIwOUJFNjIwNEEKUldSS0lPYWJJQ1IwVmFzRkRiYnhFb1U0UEREamQrZ3lEK2puaDB0OThIb2o4aFIwdTZPU093OFUK",
      "endpoints": [
        "https://github.com/nadeemmhdm/open-ui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
